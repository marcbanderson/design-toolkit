#!/usr/bin/env python3
"""Publish the live judgments file into the toolkit, with client names scrubbed.

  tools/publish-judgment            write judgment/marc.md from ~/.claude/design-judgments.md
  tools/publish-judgment --check    report what would be scrubbed, write nothing

The name map lives outside the repo, in ~/.claude/judgment-publish-map.json, so
the names it removes are never committed. Without the map nothing is published.
The run fails if any forbidden term survives the replacements.
"""
import json, os, re, sys
HOME = os.path.expanduser("~")
SRC = os.path.join(HOME, ".claude", "design-judgments.md")
MAP = os.path.join(HOME, ".claude", "judgment-publish-map.json")
DEST = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "judgment", "marc.md")

if not os.path.exists(MAP):
    sys.exit(f"No name map at {MAP}; refusing to publish unscrubbed.")
m = json.load(open(MAP))
s = open(SRC, encoding="utf-8").read()
counts = []
for old, new in m["replace"]:
    n = s.count(old)
    if n: counts.append((n, old)); s = s.replace(old, new)
left = [(t, s.count(t)) for t in m["forbid"] if t in s]
print(f"{sum(n for n, _ in counts)} replacements in {len(counts)} patterns")
if left:
    for t, n in left:
        print(f"  still present: {n} x a forbidden term (index {m['forbid'].index(t)})")
    sys.exit("Not published: add a replacement for each term above to the map.")
if "--check" in sys.argv:
    print("check only, nothing written"); sys.exit(0)
open(DEST, "w", encoding="utf-8").write(s)
upd = re.search(r"_Last updated: ([0-9-]+)", s)
print(f"wrote {os.path.relpath(DEST)} (last updated {upd.group(1) if upd else 'unknown'})")
